{
  "manifest_version": 3,
  "name": "Router Killer - ZTE F660 Automator",
  "version": "1.0.0",
  "description": "Otomatisasi login, navigasi menu, dan konfigurasi nama SSID pada router ZTE F660.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Router Killer"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "*://192.168.1.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://192.168.1.1/*",
        "http://*/*"
      ],
      "js": ["content/router_automation.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
